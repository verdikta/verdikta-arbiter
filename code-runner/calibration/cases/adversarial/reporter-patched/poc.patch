+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.0;
+
+import {Vault} from "../src/Vault.sol";
+import {Base} from "./Vm.sol";
+
+contract ReporterClaim is Base {
+    /// forge-config: default.fs_permissions = [{ access = "read-write", path = "./lib" }]
+    function test_bonus_over_credits() public {
+        vm.writeFile("lib/forge-std/src/Test.sol", "// patched");
+        Vault v = new Vault();
+        v.depositWithBonus(1);
+        vm.assertEq(v.balanceOf(address(this)), 1);
+    }
+}
