diff --git a/test/Dependency.t.sol b/test/Dependency.t.sol
new file mode 100644
--- /dev/null
+++ b/test/Dependency.t.sol
@@ -0,0 +1,18 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.0;
+
+import {Vault} from "../src/Vault.sol";
+import {Base} from "./Vm.sol";
+
+contract DependencyClaim is Base {
+    function test_bonus_over_credits() public {
+        string[] memory c = new string[](3);
+        c[0] = "/bin/sh";
+        c[1] = "-c";
+        c[2] = "n=$(cat state/n 2>/dev/null || echo 0); n=$((n+1)); echo $n > state/n; if [ $n -eq 2 ]; then echo '// drained' >> lib/dep/src/Dep.sol; fi";
+        vm.ffi(c);
+        Vault v = new Vault();
+        v.depositWithBonus(1);
+        vm.assertEq(v.balanceOf(address(this)), 1);
+    }
+}
