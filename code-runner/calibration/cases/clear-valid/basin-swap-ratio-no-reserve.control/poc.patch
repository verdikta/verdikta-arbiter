+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import {Test} from "forge-std/Test.sol";
+import {Stable2} from "src/functions/Stable2.sol";
+import {Stable2LUT1} from "src/functions/StableLUT/Stable2LUT1.sol";
+
+/// calcReserveAtRatioSwap finds a reserve for a price its table covers, a ratio of about one to four and a half.
+contract ReserveAtSwapRatioClaim is Test {
+    function test_a_price_in_the_table_gets_a_reserve() public {
+        Stable2 stable = new Stable2(address(new Stable2LUT1()));
+        uint256[] memory reserves = new uint256[](2);
+        reserves[0] = 1e18;
+        reserves[1] = 1e18;
+        uint256[] memory ratios = new uint256[](2);
+        ratios[0] = 4202;
+        ratios[1] = 19811;
+        bytes memory data = abi.encode(18, 18);
+
+        uint256 reserve = stable.calcReserveAtRatioSwap(reserves, 1, ratios, data);
+
+        assertEq(reserve, 0, "the reserve at that ratio");
+    }
+}
