+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import {Test} from "forge-std/Test.sol";
+import {Stable2} from "src/functions/Stable2.sol";
+import {Stable2LUT1} from "src/functions/StableLUT/Stable2LUT1.sol";
+
+/// calcReserveAtRatioLiquidity answers for a price its table covers, rather than underflowing on the way there.
+contract ReserveAtLiquidityRatioClaim is Test {
+    function test_a_price_in_the_table_does_not_underflow() public {
+        Stable2 stable = new Stable2(address(new Stable2LUT1()));
+        uint256[] memory reserves = new uint256[](2);
+        reserves[0] = 1e18;
+        reserves[1] = 1e18;
+        uint256[] memory ratios = new uint256[](2);
+        ratios[0] = 8;
+        ratios[1] = 1;
+
+        vm.expectRevert(abi.encodeWithSignature("Panic(uint256)", 0x11));
+        uint256 reserve = stable.calcReserveAtRatioLiquidity(reserves, 0, ratios, abi.encode(18, 18));
+
+        assertEq(reserve, 0, "the reserve at that ratio");
+    }
+}
