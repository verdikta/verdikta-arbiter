+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.27;
+
+import { Test } from "forge-std/Test.sol";
+import { Factory } from "../src/Factory.sol";
+
+/// A deterministic account factory answers with the account's address when the account already exists.
+contract FactorySecondDeployClaim is Test {
+
+  function test_a_second_deploy_answers_with_the_address() public {
+    Factory factory = new Factory();
+    address mainModule = address(0x1000);
+    bytes32 salt = bytes32(uint256(7));
+
+    address first = factory.deploy(mainModule, salt);
+    vm.expectRevert(abi.encodeWithSelector(Factory.DeployFailed.selector, mainModule, salt));
+    address second = factory.deploy(mainModule, salt);
+
+    assertEq(second, address(0), "the second deploy gives the same address");
+    first;
+  }
+
+}
