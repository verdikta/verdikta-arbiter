diff --git a/test/WellDataDecimalsClaim.t.sol b/test/WellDataDecimalsClaim.t.sol
new file mode 100644
--- /dev/null
+++ b/test/WellDataDecimalsClaim.t.sol
@@ -0,0 +1,17 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import {Test} from "forge-std/Test.sol";
+import {Stable2} from "src/functions/Stable2.sol";
+import {Stable2LUT1} from "src/functions/StableLUT/Stable2LUT1.sol";
+
+/// Stable2 reads each token's decimals on their own, and takes 0 to mean 18.
+contract WellDataDecimalsClaim is Test {
+    function test_token_one_decimals_are_read_from_their_own_value() public {
+        Stable2 stable = new Stable2(address(new Stable2LUT1()));
+
+        uint256[] memory decimals = stable.decodeWellData(abi.encode(uint256(18), uint256(0)));
+
+        assertEq(decimals[1], 0, "a zero for token one means 18");
+    }
+}
