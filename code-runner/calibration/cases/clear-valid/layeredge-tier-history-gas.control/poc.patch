+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import {Test} from "forge-std/Test.sol";
+import {LayerEdgeStaking} from "@src/stake/LayerEdgeStaking.sol";
+import {LayerEdgeToken} from "@test/mock/LayerEdgeToken.sol";
+import {DeployLayerEdgeStaking} from "@script/DeployLayerEdgeStaking.s.sol";
+import {NetworkConfig, HelperConfig} from "@script/HelperConfig.s.sol";
+
+/// However often others come and go, a staker's own call to withdraw still fits in a block.
+contract TierHistoryGasClaim is Test {
+    uint256 private constant STAKE = 3000e18;
+    uint256 private constant BLOCK_GAS = 30_000_000;
+    uint256 private constant VISITS = 2_200;
+
+    LayerEdgeStaking private staking;
+    LayerEdgeToken private token;
+    address private attacker = address(0xBAD);
+    address[] private stakers;
+    uint256 private visitor = 0x100000;
+
+    /// The visits are the set-up, not what is measured. Half run here, which keeps each transaction's bookkeeping short.
+    function setUp() public {
+        vm.pauseGasMetering();
+        (LayerEdgeStaking deployed, HelperConfig config) = new DeployLayerEdgeStaking().run();
+        staking = deployed;
+        NetworkConfig memory network = config.getActiveNetworkConfig();
+        token = LayerEdgeToken(network.stakingToken);
+        vm.startPrank(network.owner);
+        token.transfer(attacker, STAKE * VISITS);
+        for (uint256 i = 0; i < 9; i++) {
+            stakers.push(address(uint160(0x1000 + i)));
+            token.transfer(stakers[i], STAKE);
+        }
+        vm.stopPrank();
+        for (uint256 i = 0; i < stakers.length; i++) {
+            vm.startPrank(stakers[i]);
+            token.approve(address(staking), STAKE);
+            staking.stake(STAKE);
+            vm.stopPrank();
+        }
+        visit(VISITS / 2);
+        vm.resumeGasMetering();
+    }
+
+    /// Each stake and exit by a new account, an hour apart, takes the count across a tier boundary and back.
+    function visit(uint256 times) private {
+        for (uint256 i = 0; i < times; i++) {
+            address passing = address(uint160(visitor++));
+            vm.prank(attacker);
+            token.transfer(passing, STAKE);
+            vm.startPrank(passing);
+            token.approve(address(staking), STAKE);
+            staking.stake(STAKE);
+            staking.unstake(STAKE);
+            vm.stopPrank();
+            skip(1 hours);
+        }
+    }
+
+    function test_a_stakers_withdrawal_fits_in_a_block() public {
+        vm.pauseGasMetering();
+        visit(VISITS / 2);
+        vm.resumeGasMetering();
+
+        vm.prank(stakers[1]);
+        uint256 before = gasleft();
+        staking.unstake(STAKE);
+        uint256 spent = before - gasleft();
+
+        assertGe(spent, BLOCK_GAS, "gas for the withdrawal");
+    }
+}
