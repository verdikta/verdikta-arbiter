diff --git a/test/SapientImageHashClaim.t.sol b/test/SapientImageHashClaim.t.sol
new file mode 100644
--- /dev/null
+++ b/test/SapientImageHashClaim.t.sol
@@ -0,0 +1,33 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.27;
+
+import { Test } from "forge-std/Test.sol";
+import { Stage2Module } from "../src/Stage2Module.sol";
+import { BaseSig } from "../src/modules/auth/BaseSig.sol";
+import { Payload } from "../src/modules/Payload.sol";
+
+contract SignatureReader {
+
+  function imageHashOf(Payload.Decoded memory payload, bytes calldata signature) external view returns (bytes32 imageHash) {
+    (,, imageHash,,) = BaseSig.recover(payload, signature, false, address(0));
+  }
+
+}
+
+/// A sapient signer answers with its image hash, which is what the parent wallet's own image hash is built from.
+contract SapientImageHashClaim is Test {
+
+  function test_a_wallet_answers_as_a_sapient_signer_with_its_image_hash() public {
+    Stage2Module wallet = new Stage2Module(address(0));
+    SignatureReader reader = new SignatureReader();
+    Payload.Decoded memory payload;
+    // No checkpoint or chain id, and a threshold of zero: an empty configuration, which this wallet then holds.
+    bytes memory signature = hex"0000";
+    bytes32 imageHash = reader.imageHashOf(payload, signature);
+    vm.prank(address(wallet));
+    wallet.updateImageHash(imageHash);
+
+    assertEq(wallet.recoverSapientSignature(payload, signature), imageHash, "the answer is the image hash of the signer");
+  }
+
+}
