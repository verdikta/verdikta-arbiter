diff --git a/test/PenaltyAfterTheLockClaim.t.sol b/test/PenaltyAfterTheLockClaim.t.sol
new file mode 100644
--- /dev/null
+++ b/test/PenaltyAfterTheLockClaim.t.sol
@@ -0,0 +1,57 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.23;
+
+import {Test} from "forge-std/Test.sol";
+import {Lock} from "src/Lock.sol";
+import {LockList} from "src/libraries/LockList.sol";
+import {MockToken} from "src/mock/MockToken.sol";
+
+/// The penalty is for leaving before a lock has run. A staker who stayed for the whole lock should pay no more than one who left early.
+contract PenaltyAfterTheLockClaim is Test {
+    function test_staying_longer_does_not_cost_a_larger_penalty() public {
+        vm.warp(1_700_000_000);
+        (Lock lock, MockToken stakingToken,) = deployed();
+        address leftEarly = address(0xA);
+        address stayed = address(0xB);
+        address treasury = lock.treasury();
+        staked(lock, stakingToken, leftEarly, 100e18);
+        staked(lock, stakingToken, stayed, 100e18);
+
+        vm.warp(block.timestamp + 20 days);
+        vm.prank(leftEarly);
+        lock.earlyExitById(0);
+        uint256 paidAfterTwentyDays = stakingToken.balanceOf(treasury);
+
+        vm.warp(block.timestamp + 11 days);
+        vm.prank(stayed);
+        lock.earlyExitById(1);
+        uint256 paidAfterThirtyOneDays = stakingToken.balanceOf(treasury) - paidAfterTwentyDays;
+
+        assertLe(paidAfterThirtyOneDays, paidAfterTwentyDays, "the penalty after 31 days, against the one after 20");
+    }
+
+    function deployed() private returns (Lock lock, MockToken stakingToken, MockToken rewardToken) {
+        stakingToken = new MockToken("stake", "STK", 18);
+        rewardToken = new MockToken("reward", "RWD", 18);
+        LockList locks = new LockList(address(this));
+        lock = new Lock();
+        lock.initialize(address(locks), 15000, 35000, address(this));
+        lock.setStakingToken(address(stakingToken));
+        lock.addReward(address(rewardToken));
+        uint256[] memory periods = new uint256[](1);
+        periods[0] = 30 days;
+        uint256[] memory multipliers = new uint256[](1);
+        multipliers[0] = 1;
+        lock.setLockTypeInfo(periods, multipliers);
+        lock.setTreasury(address(0x7E));
+        locks.transferOwnership(address(lock));
+    }
+
+    function staked(Lock lock, MockToken token, address who, uint256 amount) private {
+        token.mint(who, amount);
+        vm.startPrank(who);
+        token.approve(address(lock), amount);
+        lock.stake(amount, who, 0);
+        vm.stopPrank();
+    }
+}
