+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import {Test} from "forge-std/Test.sol";
+import {Aquifer} from "src/Aquifer.sol";
+import {Call, IERC20, Well} from "src/Well.sol";
+import {Stable2} from "src/functions/Stable2.sol";
+import {Stable2LUT1} from "src/functions/StableLUT/Stable2LUT1.sol";
+import {WellDeployer} from "script/helpers/WellDeployer.sol";
+import {MockToken} from "mocks/tokens/MockToken.sol";
+
+/// Taking a token out of a well has to be paid for, whichever token it is.
+contract ThirdTokenSwapClaim is Test, WellDeployer {
+    function test_taking_the_third_token_out_costs_something() public {
+        IERC20[] memory tokens = new IERC20[](3);
+        uint256[] memory amounts = new uint256[](3);
+        for (uint256 k = 0; k < 3; k++) {
+            MockToken token = new MockToken("T", "T", 18);
+            tokens[k] = token;
+            amounts[k] = 1000e18;
+        }
+
+        Call memory curve = Call(address(new Stable2(address(new Stable2LUT1()))), abi.encode(18, 18));
+        Well well = encodeAndBoreWell(address(new Aquifer()), address(new Well()), tokens, curve, new Call[](0), bytes32(0));
+
+        for (uint256 k = 0; k < 3; k++) {
+            MockToken(address(tokens[k])).mint(address(this), 2000e18);
+            tokens[k].approve(address(well), type(uint256).max);
+        }
+        well.addLiquidity(amounts, 0, address(this), type(uint256).max);
+
+        uint256 paid = well.swapTo(tokens[0], tokens[2], 1000e18, 157e18, address(this), type(uint256).max);
+
+        assertEq(paid, 0, "what the swap takes in for the third token");
+    }
+}
