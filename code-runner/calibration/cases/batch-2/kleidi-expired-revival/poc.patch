diff --git a/test/ExpiredOperationClaim.t.sol b/test/ExpiredOperationClaim.t.sol
new file mode 100644
--- /dev/null
+++ b/test/ExpiredOperationClaim.t.sol
@@ -0,0 +1,34 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.25;
+
+import {Test} from "forge-std/Test.sol";
+import {Timelock} from "src/Timelock.sol";
+import {MIN_DELAY} from "src/utils/Constants.sol";
+import {MockSafe} from "test/mock/MockSafe.sol";
+
+/// Once its window has closed, an operation is finished with: a later setting should not open that window again.
+contract ExpiredOperationClaim is Test {
+    function test_an_expired_operation_stays_expired() public {
+        vm.warp(1_000_000);
+        MockSafe safe = new MockSafe();
+        Timelock timelock = new Timelock(address(safe), MIN_DELAY, 5 days, address(0x11111), 10 days, new address[](0));
+
+        bytes memory old = abi.encodeCall(Timelock.updateDelay, (MIN_DELAY));
+        bytes memory longer = abi.encodeCall(Timelock.updateExpirationPeriod, (30 days));
+        bytes32 oldId = timelock.hashOperation(address(timelock), 0, old, bytes32(0));
+
+        vm.prank(address(safe));
+        timelock.schedule(address(timelock), 0, old, bytes32(0), MIN_DELAY);
+
+        // Its five-day window passes with nobody executing it.
+        vm.warp(block.timestamp + MIN_DELAY + 5 days);
+        assertTrue(timelock.isOperationExpired(oldId), "expired once its window has closed");
+
+        vm.prank(address(safe));
+        timelock.schedule(address(timelock), 0, longer, bytes32(0), MIN_DELAY);
+        vm.warp(block.timestamp + MIN_DELAY);
+        timelock.execute(address(timelock), 0, longer, bytes32(0));
+
+        assertTrue(timelock.isOperationExpired(oldId), "still expired after the setting changes");
+    }
+}
