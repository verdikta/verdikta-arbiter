+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.23;
+
+import {Test} from "forge-std/Test.sol";
+import {Lock} from "src/Lock.sol";
+import {LockList} from "src/libraries/LockList.sol";
+import {MockToken} from "src/mock/MockToken.sol";
+
+/// A staker sends an exit with a minute of the lock to run. If it lands a little late, the wait should not jump to a whole new lock.
+contract ExitAcrossTheCycleClaim is Test {
+    function test_an_exit_landing_two_minutes_late_does_not_wait_a_month() public {
+        vm.warp(1_700_000_000);
+        (Lock lock, MockToken stakingToken,) = deployed();
+        address staker = address(0xA);
+        staked(lock, stakingToken, staker, 100e18);
+
+        // Sent with one minute left, mined two minutes on.
+        vm.warp(block.timestamp + 30 days - 1 minutes);
+        uint256 seenWhenSent = lock.calcRemainUnlockPeriod(lock.locklist().getLockById(staker, 0));
+        vm.warp(block.timestamp + 2 minutes);
+
+        vm.prank(staker);
+        try lock.exitLateById(0) {
+            uint256 waitNow = lock.locklist().getLockById(staker, 0).unlockTime - block.timestamp;
+            assertLe(waitNow, seenWhenSent + 2 minutes, "the wait the staker gets, against the one it saw");
+        } catch {
+            // Refusing the exit is an answer too: the staker can decide again.
+        }
+    }
+
+    function deployed() private returns (Lock lock, MockToken stakingToken, MockToken rewardToken) {
+        stakingToken = new MockToken("stake", "STK", 18);
+        rewardToken = new MockToken("reward", "RWD", 18);
+        LockList locks = new LockList(address(this));
+        lock = new Lock();
+        lock.initialize(address(locks), 15000, 35000, address(this));
+        lock.setStakingToken(address(stakingToken));
+        lock.addReward(address(rewardToken));
+        uint256[] memory periods = new uint256[](1);
+        periods[0] = 30 days;
+        uint256[] memory multipliers = new uint256[](1);
+        multipliers[0] = 1;
+        lock.setLockTypeInfo(periods, multipliers);
+        lock.setTreasury(address(0x7E));
+        locks.transferOwnership(address(lock));
+    }
+
+    function staked(Lock lock, MockToken token, address who, uint256 amount) private {
+        token.mint(who, amount);
+        vm.startPrank(who);
+        token.approve(address(lock), amount);
+        lock.stake(amount, who, 0);
+        vm.stopPrank();
+    }
+}
