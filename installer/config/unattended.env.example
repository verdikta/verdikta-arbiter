# Verdikta Arbiter — unattended install / upgrade answers
#
# Copy this file, fill it in, keep it private (chmod 600: it holds secrets), then:
#
#   installer/bin/install.sh --answers /path/to/answers.env
#   installer/bin/upgrade-arbiter.sh --answers /path/to/answers.env
#
# Every VA_* key answers one installer prompt. Commented keys show the default
# the installer uses when the key is missing. Yes/no keys accept y/n (also
# yes/no, true/false, 1/0). Lines are plain bash assignments: quote values.
# Delete the file when the run is done.

# ───────────────────────── install.sh ─────────────────────────

# Where the arbiter is installed.
#VA_INSTALL_DIR="$HOME/verdikta-arbiter-node"
# If VA_INSTALL_DIR already holds an arbiter: overwrite | cancel (default cancel → the run stops).
#VA_EXISTING_INSTALL_ACTION="cancel"
# If VA_INSTALL_DIR exists with unrelated files: use it anyway? (default n → the run stops)
#VA_USE_NONEMPTY_DIR="n"

# Prerequisites the installer may add (Ubuntu/Debian; needs sudo without a password prompt).
#VA_INSTALL_NODE="y"
#VA_INSTALL_DOCKER="y"

# Network: base_sepolia (testnet, default) or base_mainnet (real ETH/LINK).
#VA_NETWORK="base_sepolia"

# RPC endpoints — EITHER an Infura key (endpoints generated for the network) …
#VA_INFURA_API_KEY=""
# … OR explicit semicolon-separated lists (same count, paired in order). Explicit lists win.
#VA_RPC_HTTP_URLS="https://base-sepolia.example/v2/KEY"
#VA_RPC_WS_URLS="wss://base-sepolia.example/v2/KEY"
# Keep going if an RPC endpoint fails the preflight check? (default n)
#VA_CONTINUE_ON_RPC_FAILURE="n"

# Deployment wallet private key (REQUIRED). 64 hex chars; a 0x prefix is tolerated.
# Use a dedicated wallet holding only the ETH needed for deployment + key funding.
VA_PRIVATE_KEY=""

# AI provider keys — leave blank to skip a provider. ClassID 128 needs OpenAI + Anthropic,
# 129 needs none (local Ollama), 130 needs Hyperbolic, 131 needs all four.
#VA_OPENAI_API_KEY=""
#VA_ANTHROPIC_API_KEY=""
#VA_HYPERBOLIC_API_KEY=""
#VA_XAI_API_KEY=""
# OpenRouter fills gaps for providers without a native key (optional).
#VA_OPENROUTER_API_KEY=""
# With native keys AND an OpenRouter key: route everything via OpenRouter? (default n = native-first)
#VA_ROUTE_ALL_VIA_OPENROUTER="n"
# Pinata JWT for IPFS uploads (needed to reveal justifications in production).
#VA_PINATA_JWT=""

# @verdikta/common version: latest (default) or beta.
#VA_VERDIKTA_COMMON_VERSION="latest"
# Justification model, by menu number 1-10 (default: recommended for the keys you gave):
#  1 gpt-5-nano  2 gpt-5-mini  3 gpt-5  4 claude-sonnet-4  5 claude-3-7-sonnet
#  6 Kimi-K2 (Hyperbolic)  7 grok-4-1-fast (xAI)  8 gemma3n:e4b  9 deepseek-r1:8b  10 llama3.1:8b (Ollama)
#VA_JUSTIFICATION_MODEL=""
# Pull missing Ollama models during install (only when Ollama is present)? (default n)
#VA_PULL_OLLAMA_MODELS="n"

# Existing chainlink / cl-postgres containers found on the host:
#VA_DOCKER_BACKUP_EXISTING_DB="y"        # dump the old database first
#VA_DOCKER_CONTINUE_WITHOUT_BACKUP="n"   # asked only when the old cl-postgres is STOPPED (no dump possible); n cancels the install (exit 1 unattended)
#VA_DOCKER_REMOVE_EXISTING="n"           # remove the old containers? (default n → the run stops)

# Chainlink node UI login (password is generated and saved to ~/.chainlink-<net>/.api).
#VA_CHAINLINK_EMAIL="admin@example.com"

# Jobs: number of arbiters (1-10) and the host address the Chainlink container calls back to.
#VA_ARBITER_COUNT="1"
#VA_HOST_IP=""                            # default: first address from `hostname -I`

# Dispatcher registration (needs 100 wVDKA per job + a little ETH; default n = register later
# with $VA_INSTALL_DIR/register-oracle.sh).
#VA_REGISTER_ORACLE="n"
#VA_AGGREGATOR_ADDRESS="0x..."            # required when VA_REGISTER_ORACLE=y — current dispatchers (docs/deployments.md):
#                                         #   Base Sepolia 0xe8a385E473EA710c5a88Cc72681a16a26fe380e4
#                                         #   Base Mainnet 0xd8F38bCBEE43bE3bd31655a563f20c9B3e67142a
#VA_CLASS_IDS="128"                       # space- or comma-separated
#VA_ORACLE_FEE_ETH="0.00002"              # oracle fee per job in ETH (NOT LINK); must be <= the dispatcher ceiling 0.0004 or the node is never selected
#VA_DEREGISTER_ORACLE="n"                 # unregister-oracle.sh --unattended: y to deregister (refunds the 100 wVDKA stake); VA_AGGREGATOR_ADDRESS defaults to the recorded one

# Monitoring.
#VA_INSTALL_CRON="y"                      # watchdog (every 2 min) + daily log rotation
#VA_STATUS_PAGE_REPORTING="y"             # report health to the arbiter status page
#VA_STATUS_PAGE_WEBHOOK="https://arbiters.verdikta.org/api/alerts"
#VA_LOG_LEVEL="info"                      # error | warn | info | debug

# Fund the Chainlink keys from the deployment wallet at the end of the install? (default n)
#VA_FUND_KEYS="n"
#VA_FUND_AMOUNT=""                        # ETH per key; blank = recommended (0.005 testnet / 0.002 mainnet)

# Start the services when the install finishes? (default y)
#VA_START_SERVICES="y"

# ───────────────────────── upgrade-arbiter.sh ─────────────────────────
# Unset keys take the SAFE defaults shown here; the only keys most upgrades need are
# VA_INSTALL_DIR (or --target-dir) and, optionally, VA_UPGRADE_BACKUP.

#VA_UPGRADE_PROCEED="y"
#VA_UPGRADE_BACKUP="y"                    # copy the installation aside first
#VA_UPGRADE_BACKUP_KEEP="3"               # after the new backup succeeds keep the newest N install backups (0 = keep all)
#VA_UPGRADE_REVIEW_API_KEYS="n"           # must stay n unattended (interactive review)
#VA_UPGRADE_UPDATE_JUSTIFIER="n"          # y → also set VA_JUSTIFIER_MODEL="Provider:model"
#VA_JUSTIFIER_MODEL=""
#VA_UPGRADE_UPDATE_RPC="n"                # y → also set the RPC keys above
#VA_UPGRADE_REGENERATE_JOBS="n"           # y = new job IDs + on-chain unregister/re-register (costly; leave n)
#VA_UPGRADE_SWITCH_COMMON_LATEST="y"
#VA_UPGRADE_INTEGRATE_MODELS="y"
#VA_UPGRADE_RECONFIGURE_JOBS="n"
#VA_UPGRADE_REGENERATE_CHAINLINK_CONFIG="n"
#VA_UPGRADE_DOCKER_LOG_ROTATION="y"
#VA_INSTALL_LOG_ROTATION_CRON="y"         # (upgrade asks for the two cron entries separately)
#VA_RESTART_SERVICES="y"                  # restart the arbiter if it was running before the upgrade
